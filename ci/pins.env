# SPDX-License-Identifier: GPL-2.0
# Pinned prebuilt revisions for the RMX5110 (MT6878, kernel 6.1 GKI) build.
# Source of pin: AOSP kernel manifest branch common-android14-6.1
# (https://android.googlesource.com/kernel/manifest), default revision
# "main-kernel-build-2023". Hashes below were resolved on 2026-10-24 and are
# the exact commits fetch_prebuilts.sh checks out. Bump only deliberately and
# record why in MAINTAINER_NOTES.md.
#
# Clang revision is independently pinned by the kernel source itself in
# build.config.constants (CLANG_VERSION=r487747c), and the prebuilts tree's
# kleaf/versions.bzl lists exactly r487747c on this branch.

AOSP_GIT="https://android.googlesource.com"
PIN_BRANCH="main-kernel-build-2023"

# project path under workspace : googlesource project : pinned hash
PIN_CLANG="platform/prebuilts/clang/host/linux-x86 382db94fa9597402b69e252c36bf9902cc283b82"
PIN_BUILD_TOOLS="platform/prebuilts/build-tools 4649614b4030ad825f2e94401d04526651f44e88"
PIN_KERNEL_BUILD_TOOLS="kernel/prebuilts/build-tools e905be252a53d20c52bd9e59df3ff8fdd46b9eab"
PIN_BAZEL="platform/prebuilts/bazel/linux-x86_64 7bfbec9e829bbae6816d5f39aba345df76e627c1"
PIN_JDK11="platform/prebuilts/jdk/jdk11 649eec4416e2ed6298af49a56876772767a0e5ae"
PIN_NDK_R23="toolchain/prebuilts/ndk/r23 19ac7e4eded12adb99d4f613490dde6dd0e72664"
PIN_BAZEL_COMMON_RULES="platform/build/bazel_common_rules 62c496cd1d821948d2f4a7fcf702e54416e5a754"
PIN_SKYLIB="platform/external/bazel-skylib f998e5dc13c03f0eae9e373263d3afff0932c738"
PIN_STARDOC="platform/external/stardoc e83f522ee95419e55d2c5654aa6e0143beeef595"
PIN_ABSL_PY="platform/external/python/absl-py 2f199605a9875340569e039657f8b4c72d51b84d"
# mkbootimg is only needed by the Phase 2 image repack scripts, fetched already
# so the workspace matches the full manifest layout.
PIN_MKBOOTIMG="platform/system/tools/mkbootimg 615a1fced5f8e2755642d30357674d3bfa21b85e"
